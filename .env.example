# .env.example - consider this as template for your .env file
# DONOT commit .env to git

# YOUR LLM API KEY (AS THIS IS A CREW-AI PROJECT, CONSIDER OPEN-AI, GEMINI, ANTHROPIC)
GEMINI_API_KEY=your_gemini_api_key_here

# NEWSAPI KEY
NEWS_API_KEY=your_newsapi_key_here

# POSTGRESQL DATABASE URL
DATABASE_URL=postgresql://finance_user:finance_password@localhost:5432/finance_db

# REDIS
REDIS_URL=redis://localhost:6379

# JWT
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_very_long_random_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# APP
APP_NAME=TRAX-AI
DEBUG=False